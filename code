{% extends "base.html" %}

{% block title %}Leave Request{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <nav class="text-xs text-gray-500 mb-4">
        <a href="{% url 'dpa_admin_dashboard' %}" class="hover:text-indigo-600">DPA Dashboard</a>
        <span class="mx-2">/</span>
        <a href="{% url 'dpa_leave_list' %}" class="hover:text-indigo-600">Leave</a>
        <span class="mx-2">/</span>
        <span class="text-gray-700">Request #{{ leave.id }}</span>
    </nav>

    <div class="bg-white rounded-xl border border-gray-200 p-6 mb-6">
        <div class="flex items-start justify-between gap-4 flex-wrap mb-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">
                    {{ leave.staff.get_full_name|default:leave.staff.email }}
                </h1>
                <p class="text-sm text-gray-500 mt-1">{{ leave.get_leave_type_display }}</p>
            </div>
            <span class="px-3 py-1 text-xs font-medium rounded-full
                {% if leave.status == 'approved' %}bg-green-100 text-green-800
                {% elif leave.status == 'pending' %}bg-amber-100 text-amber-800
                {% elif leave.status == 'rejected' %}bg-red-100 text-red-800
                {% else %}bg-gray-100 text-gray-700{% endif %}">
                {{ leave.get_status_display }}
            </span>
        </div>

        <dl class="grid grid-cols-2 gap-4 text-sm">
            <div>
                <dt class="text-gray-500">Start Date</dt>
                <dd class="text-gray-900 font-medium">{{ leave.start_date|date:"j F Y" }}</dd>
            </div>
            <div>
                <dt class="text-gray-500">End Date</dt>
                <dd class="text-gray-900 font-medium">{{ leave.end_date|date:"j F Y" }}</dd>
            </div>
            <div>
                <dt class="text-gray-500">Days Requested</dt>
                <dd class="text-gray-900 font-medium">{{ leave.days_requested }}</dd>
            </div>
            <div>
                <dt class="text-gray-500">Requested</dt>
                <dd class="text-gray-900 font-medium">{{ leave.requested_at|date:"j M Y H:i" }}</dd>
            </div>
        </dl>

        {% if leave.reason %}
        <div class="mt-6 pt-4 border-t border-gray-100">
            <dt class="text-xs font-medium text-gray-500 uppercase mb-1">Reason</dt>
            <dd class="text-sm text-gray-700 whitespace-pre-line">{{ leave.reason }}</dd>
        </div>
        {% endif %}
    </div>

    <!-- Approval chain -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 mb-6">
        <h2 class="font-semibold text-gray-900 mb-4">Approval Chain</h2>
        <div class="space-y-4">

            <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center
                    {% if leave.dpa_approved_at %}bg-green-100 text-green-700{% else %}bg-gray-100 text-gray-400{% endif %}">
                    {% if leave.dpa_approved_at %}✓{% else %}1{% endif %}
                </div>
                <div class="flex-1">
                    <p class="text-sm font-medium text-gray-900">Deputy Principal — Administration</p>
                    {% if leave.dpa_approved_at %}
                    <p class="text-xs text-gray-500">
                        {{ leave.dpa_approved_by.get_full_name|default:leave.dpa_approved_by.email }}
                        · {{ leave.dpa_approved_at|date:"j M Y H:i" }}
                    </p>
                    {% if leave.dpa_comment %}<p class="text-xs text-gray-700 mt-1">"{{ leave.dpa_comment }}"</p>{% endif %}
                    {% else %}
                    <p class="text-xs text-gray-500">Awaiting approval</p>
                    {% endif %}
                </div>
            </div>

            <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center
                    {% if leave.principal_approved_at %}bg-green-100 text-green-700{% else %}bg-gray-100 text-gray-400{% endif %}">
                    {% if leave.principal_approved_at %}✓{% else %}2{% endif %}
                </div>
                <div class="flex-1">
                    <p class="text-sm font-medium text-gray-900">Principal</p>
                    {% if leave.principal_approved_at %}
                    <p class="text-xs text-gray-500">
                        {{ leave.principal_approved_by.get_full_name|default:leave.principal_approved_by.email }}
                        · {{ leave.principal_approved_at|date:"j M Y H:i" }}
                    </p>
                    {% if leave.principal_comment %}<p class="text-xs text-gray-700 mt-1">"{{ leave.principal_comment }}"</p>{% endif %}
                    {% else %}
                    <p class="text-xs text-gray-500">Awaiting approval</p>
                    {% endif %}
                </div>
            </div>

        </div>
    </div>

    <!-- Actions -->
    {% if can_approve_dpa %}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="font-semibold text-gray-900 mb-4">Your Decision</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <form method="post" action="{% url 'dpa_approve_leave' leave.id %}" class="space-y-3">
                {% csrf_token %}
                <textarea name="comment" rows="2" placeholder="Comment (optional)"
                          class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg"></textarea>
                <button type="submit"
                        class="w-full px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700">
                    Approve & Forward to Principal
                </button>
            </form>

            <form method="post" action="{% url 'dpa_reject_leave' leave.id %}" class="space-y-3">
                {% csrf_token %}
                <textarea name="comment" rows="2" placeholder="Reason for rejection"
                          class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg"></textarea>
                <button type="submit"
                        class="w-full px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700">
                    Reject
                </button>
            </form>
        </div>
    </div>
    {% endif %}

    {% if can_approve_principal %}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="font-semibold text-gray-900 mb-4">Principal Final Approval</h2>
        <form method="post" action="{% url 'dpa_leave_principal_approve' leave.id %}" class="space-y-3">
            {% csrf_token %}
            <textarea name="comment" rows="2" placeholder="Comment (optional)"
                      class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg"></textarea>
            <button type="submit"
                    class="px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700">
                Approve as Principal
            </button>
        </form>
    </div>
    {% endif %}

</div>
{% endblock %}