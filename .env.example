# ============================================================
# ElimuCore — Environment Variables Template
# Copy this to .env and fill in real values.
# DO NOT commit .env to git.
# ============================================================

# ---------- Django ----------
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ---------- Database ----------
# Dev (SQLite): sqlite:///db.sqlite3
# Dev (Docker Postgres): postgres://elimu:elimu@localhost:5432/elimucore_dev
# Prod (Render): provided automatically as DATABASE_URL
DATABASE_URL=sqlite:///db.sqlite3

# ---------- Email (Resend SMTP for prod) ----------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ElimuCore <noreply@elimucore.co.ke>

# ---------- M-Pesa Daraja ----------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_C2B_VALIDATION_URL=
MPESA_C2B_CONFIRMATION_URL=

# ---------- Africa's Talking (SMS) ----------
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ---------- Celery ----------
CELERY_BROKER_URL=redis://localhost:6379/0

# ---------- Dev-only toggles ----------
DEBUG_SQL=False